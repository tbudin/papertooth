{
  "name": "papertooth",
  "version": "0.3.1",
  "description": "Hand-drawn Japanese stationery for the web: dotted paper, highlighters, ink, pencil, hanko stamps, washi tape and planner pieces, in CSS with an optional script.",
  "keywords": [
    "css",
    "hand-drawn",
    "sketch",
    "stationery",
    "notebook",
    "highlighter",
    "typewriter",
    "washi",
    "hanko",
    "japanese",
    "ui-kit",
    "react",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Thomas Budin",
  "homepage": "https://tbudin.github.io/papertooth/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbudin/papertooth.git"
  },
  "bugs": {
    "url": "https://github.com/tbudin/papertooth/issues"
  },
  "type": "module",
  "main": "./dist/papertooth.js",
  "module": "./dist/papertooth.js",
  "style": "./dist/papertooth.css",
  "unpkg": "./dist/papertooth.min.js",
  "jsdelivr": "./dist/papertooth.min.js",
  "types": "./types/papertooth.d.ts",
  "exports": {
    ".": {
      "types": "./types/papertooth.d.ts",
      "import": "./dist/papertooth.js",
      "default": "./dist/papertooth.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./css": "./dist/papertooth.css",
    "./min.css": "./dist/papertooth.min.css",
    "./layer.css": "./dist/papertooth.layer.css",
    "./filters.svg": "./dist/papertooth-filters.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./src/js/auto.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "prepublishOnly": "npm run build",
    "test": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
